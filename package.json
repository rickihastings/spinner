{
  "name": "spinner",
  "version": "0.1.0",
  "type": "module",
  "description": "CLI tool for running code and commands in isolated Docker containers",
  "repository": "git@github.com:rickihastings/spinner.git",
  "author": "Ricki Hastings",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "go build -o dist/spinner",
    "dev": "go build -o dist/spinner",
    "format": "go fmt ./...",
    "format:check": "test -z $(gofmt -l .)",
    "lint": "go vet ./... && $(go env GOPATH)/bin/golangci-lint run",
    "test": "go build -o dist/spinner && go test ./...",
    "prepare": "husky"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^0.20.0",
    "husky": "^9.1.7"
  }
}

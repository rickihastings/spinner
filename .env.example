# Spinner Environment Variable Configuration
#
# Copy this file to .env and set your preferred default values.
# These environment variables will be used as defaults for command-line flags.
#
# Note: Command-line flags always take precedence over environment variables.

# Setup Command Defaults
# SPINNER_NAME=default
# SPINNER_DOCKERFILE=./Dockerfile

# Spin Command Defaults
# SPINNER_IMAGE=spinner:default
# SPINNER_REPO=
# SPINNER_PROMPT=
# SPINNER_BRANCH=
# SPINNER_MAX_ITERATIONS=100
# SPINNER_RECREATE=false

# Watch Mode Defaults
# SPINNER_WATCH_HEADER=true

# Testing env vars
# SPINNER_TEST_GCP_PROJECT=
# SPINNER_TEST_GCP_ZONE=-
# SPINNER_TEST_GCP_BUCKET=
# SPINNER_TEST_SERVICE_ACCOUNT=

# GCP
SPINNER_PROJECT=
SPINNER_ZONE=
SPINNER_STATE_BUCKET=
SPINNER_SERVICE_ACCOUNT=

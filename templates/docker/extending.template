ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ENV DEBIAN_FRONTEND=noninteractive

# Install git if not present
RUN command -v git > /dev/null 2>&1 || \
    (apt-get update && apt-get install -y git ca-certificates curl sudo && rm -rf /var/lib/apt/lists/*)

# Install GitHub CLI (gh)
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg | dd of=/usr/share/keyrings/githubcli-archive-keyring.gpg && \
    chmod go+r /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" | tee /etc/apt/sources.list.d/github-cli.list > /dev/null && \
    apt-get update && \
    apt-get install -y gh && \
    rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash spinner && \
    echo "spinner ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to spinner user for Claude installation
USER spinner
WORKDIR /home/spinner

# Install claude-code if not present
RUN command -v claude > /dev/null 2>&1 || \
    (curl -fsSL https://claude.ai/install.sh | bash)
ENV PATH=/home/spinner/.local/bin:${PATH}

# Copy skill templates
RUN mkdir -p /home/spinner/.claude/skills
COPY --chown=spinner:spinner templates/skills/task-implementation-lifecycle/SKILL.md /home/spinner/.claude/skills/task-implementation-lifecycle/SKILL.md

# Copy and set up startup script
USER root
COPY templates/scripts/startup.sh /usr/local/bin/startup.sh
RUN chmod +x /usr/local/bin/startup.sh

# Copy and set up Ralph loop script
COPY templates/scripts/ralph-loop.sh /usr/local/bin/ralph-loop.sh
RUN chmod +x /usr/local/bin/ralph-loop.sh

# Set up workspace directory with correct ownership
RUN mkdir -p /home/spinner/workspace && chown spinner:spinner /home/spinner/workspace

# Switch back to spinner user
USER spinner
WORKDIR /home/spinner/workspace

CMD ["/usr/local/bin/startup.sh"]

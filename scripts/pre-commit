#!/usr/bin/env sh

echo "Running pre-commit checks..."

# Check formatting
echo "Checking code formatting..."
make format-check || {
  echo "Format check failed. Run 'make format' to fix formatting issues."
  exit 1
}

# Run linter
echo "Running linter..."
make lint || {
  echo "Linting failed. Please fix the linting errors."
  exit 1
}

# Run tests (which also runs build)
echo "Running tests..."
make test || {
  echo "Tests failed. Please fix the failing tests."
  exit 1
}

echo "All pre-commit checks passed!"
